# ==============================================================================
# HealthChain - Master Environment Configuration Template (.env.example)
# ==============================================================================

# --- BACKEND SETTINGS (Spring Boot) ---
SERVER_PORT=8085
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/healthchain_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password_here
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true
FILE_UPLOAD_DIR=./uploads/doctor_proofs
CORS_ALLOWED_ORIGIN=http://localhost:5173

# --- FRONTEND SETTINGS (Vite / React) ---
VITE_API_BASE_URL=http://localhost:8085
VITE_BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
VITE_CHAIN_ID=11155111
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# --- BLOCKCHAIN & WEB3 ---
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_PRIVATE_KEY=your_private_key_here
