# ------------------------------------------------------------------------------
# HealthChain Backend Environment Variables Template (Spring Boot)
# ------------------------------------------------------------------------------

# Server Port
SERVER_PORT=8085

# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/healthchain_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password_here

# Hibernate / JPA Configuration (update | validate | create | create-drop)
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true

# File Upload Directory for Proofs & Records
FILE_UPLOAD_DIR=./uploads/doctor_proofs

# Blockchain Node / Web3 RPC URL
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# Blockchain Deployment Private Key
BLOCKCHAIN_PRIVATE_KEY=your_private_key_here

# CORS Allowed Origin for Vite Frontend
CORS_ALLOWED_ORIGIN=http://localhost:5173
