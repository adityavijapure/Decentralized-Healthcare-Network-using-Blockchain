# ------------------------------------------------------------------------------
# HealthChain Frontend Environment Variables Template (Vite)
# ------------------------------------------------------------------------------

# Backend Spring Boot API Base URL
VITE_API_BASE_URL=http://localhost:8085

# Blockchain RPC Provider URL (Sepolia testnet / Localhost Ganache/Hardhat/Anvil)
VITE_BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# Target Network Chain ID (11155111 = Ethereum Sepolia, 31337 = Hardhat, 1337 = Ganache)
VITE_CHAIN_ID=11155111

# HealthChain Smart Contract Address
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# IPFS Gateway URL for Decentralized Medical Records Storage
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Web3Forms API Access Key (For Contact Us submission form)
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here
